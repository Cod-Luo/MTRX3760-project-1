<?xml version="1.0"?>
<!-- Project 1: connected S-maze with an east exit; dimensions are metres. -->
<sdf version="1.8">
  <world name="project1_maze">
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.1 -0.9</direction><cast_shadows>false</cast_shadows>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south">
      <static>true</static>
      <pose>0 -3 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>6 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west">
      <static>true</static>
      <pose>-3 0 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.1 6 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 6 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north">
      <static>true</static>
      <pose>0 3 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>6 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_lower">
      <static>true</static>
      <pose>3 -0.7 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.1 4.6 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.6 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_upper">
      <static>true</static>
      <pose>3 2.8 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.1 0.4 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.4 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_lower">
      <static>true</static>
      <pose>-0.5 -1 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>5 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_upper">
      <static>true</static>
      <pose>0.5 1 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>5 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="exit_lower">
      <static>true</static>
      <pose>3.75 1.6 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>1.5 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="exit_upper">
      <static>true</static>
      <pose>3.75 2.6 0.3 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>1.5 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
